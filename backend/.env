# Application
APP_NAME=VioNER
DEBUG=false

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=violent_events
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/violent_events

# Backend (paths relative to backend/ folder)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MODEL_PATH=./models/active
DEVICE=auto
ENABLE_DB_STORAGE=true
MAX_BATCH_SIZE=100
MAX_SEQUENCE_LENGTH=512

# Training (data at project root, models inside backend)
TRAIN_DATA_PATH=../data/processed/train.json
VAL_DATA_PATH=../data/processed/val.json
MODELS_OUTPUT_DIR=./models

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
